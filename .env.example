# Copy to .env. Keep the local server bound to 127.0.0.1 with this demo token.
OPERATOR_TOKEN=local-demo-only
OPERATOR_NAME=Demo operator
DATABASE_URL=sqlite:///data/folio.db
PROVIDER=fixture
# Live extraction is opt-in. Choose a currently available free-tier vision model.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional real local inference: PROVIDER=ollama, start Ollama and pull this model.
OLLAMA_MODEL=qwen3-vl:4b-instruct
OLLAMA_TIMEOUT_SECONDS=240
RETENTION_DAYS=7
